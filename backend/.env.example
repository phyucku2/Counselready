# Copy to .env for local development. .env is gitignored and must never be committed.
# Real credentials live in Azure Key Vault (ADR-0002) — never in this file, never in a
# commit, and never passed on a command line.

APP_ENV=local
LOG_LEVEL=INFO

# Local Postgres. Leave unset to boot the API without a database for API-shape work.
# DATABASE_URL=postgresql+asyncpg://counselready:counselready@localhost:5432/counselready
